<?php

namespace Illuminate\Console\View\Components;

class Factory
{
    /**
     * Magic methods such as task() run a callback and rethrow whatever it
     * throws, so a call can throw any Throwable, not only the original
     * InvalidArgumentException. Without this, PHPStan reports catch blocks
     * around $this->components->task(...) as dead.
     *
     * @param  string  $method
     * @param  array<mixed>  $parameters
     * @return mixed
     *
     * @throws \Throwable
     */
    public function __call($method, $parameters) {}
}
